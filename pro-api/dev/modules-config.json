{
  "services": {
    "multichain": {
      "description": "Multichain aggregator service for searching and fetching data across multiple blockchains. Use {cluster_id}=multichain for endpoints that require it.",
      "service_url": "https://multichain-aggregator.services.blockscout.com",
      "swagger_url": "https://raw.githubusercontent.com/blockscout/swaggers/refs/heads/master/services/multichain-aggregator/2.1.2/swagger.yaml",
      "api_key": null,
      "root": true,
      "allowed_paths": [
        "^/api/v1/search:quick$",
        "^/api/v1/clusters/[^/]+/search/(?:addresses|block-numbers|blocks|domains|nfts|tokens|transactions)$",
        "^/api/v1/clusters/[^/]+/search:quick$",
        "^/api/v1/clusters/[^/]+/chains$"
      ],
      "featured_paths": {
        "^/api/v1/search:quick$": ["Builder", "Pro", "Business"],
        "^/api/v1/clusters/[^/]+/search:quick$": ["Builder", "Pro", "Business"]
      }
    },
    "metadata": {
      "description": "Addresses metadata service for fetching metadata and tags for addresses",
      "service_url": "https://metadata.services.blockscout.com",
      "swagger_url": "https://raw.githubusercontent.com/blockscout/swaggers/refs/heads/master/services/metadata/2.6.16/swagger.yaml",
      "api_key": null,
      "root": true,
      "allowed_paths": [
        "^\/api\/v1\/metadata$"
      ],
      "featured_paths": {
        "^/api/v1/metadata$": ["Builder", "Pro", "Business"]
      }
    },
    "bens": {
      "description": "Blockscout ENS service for fetching ENS data",
      "service_url": "https://bens.services.blockscout.com",
      "swagger_url": "https://raw.githubusercontent.com/blockscout/swaggers/refs/heads/master/services/bens/1.7.4/swagger.yaml",
      "api_key": null,
      "root": true,
      "allowed_paths": [
        "^\/?api\/v1(?:\/|$)"
      ],
      "featured_paths": {
        "^/api/v1/protocols$": ["Builder", "Pro", "Business"],
        "^/api/v1/[^/]+/protocols$": ["Builder", "Pro", "Business"]
      }
    }
  },
  "blockscout": {
    "swagger_url": "https://raw.githubusercontent.com/blockscout/swaggers/refs/heads/master/blockscout/dev/all/swagger.yaml",
    "featured_paths": {
      "^/api/v2/stats$": ["Builder", "Pro", "Business"],
      "^/api/v2/transactions$": ["Builder", "Pro", "Business"]
    },
    "services": {
      "stats-service": {
        "swagger_url": "https://raw.githubusercontent.com/blockscout/swaggers/refs/heads/master/services/stats/2.15.0/swagger.yaml",
        "description": "Stats service for fetching stats for a blockchain",
        "featured_paths": {
          "^/api/v1/counters$": ["Builder", "Pro", "Business"],
          "^/api/v1/lines$": ["Builder", "Pro", "Business"]
        }
      }
    }
  } 
}
